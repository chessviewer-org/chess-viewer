{
  "name": "chess-viewer",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=12.15.0"
  },
  "dependencies": {
    "@chessviewer-org/chess-viewer": "^1.6.0",
    "fflate": "^0.8.3",
    "preact": "^11.0.2",
    "uqr": "^0.1.3",
    "wouter": "^3.13.0"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build && node scripts/update-csp-hash.mjs && pnpm prerender",
    "build:vite": "vite build",
    "prerender": "node scripts/prerender.mjs",
    "preview": "vite preview",
    "pieces:fairy": "node scripts/generate-fairy-pieces.mjs",
    "build:analyze": "vite build && npx vite-bundle-visualizer",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "lint:ci": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:ci": "prettier --check .",
    "test": "node --experimental-strip-types --import ./scripts/register-test-aliases.mjs --test \"tests/*.test.ts\"",
    "validate": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.4",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "sass": "^1.106.1",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5"
  },
  "optionalDependencies": {
    "puppeteer": "^25.16.0"
  }
}
