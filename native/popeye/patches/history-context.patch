+/* Supply the preceding played move when solving a fresh interactive diagram. */
+static boolean chessviewer_previous_vector(numvec *diff)
+{
+  int const from = EM_ASM_INT({ return Module['previousMove'] ? Module['previousMove'].from : -1; });
+  int const to = EM_ASM_INT({ return Module['previousMove'] ? Module['previousMove'].to : -1; });
+  if (from<0 || from>=64 || to<0 || to>=64) return false;
+  *diff = (from%8-to%8) + (isBoardReflected ? from/8-to/8 : to/8-from/8)*onerow;
+  return true;
+}
+#endif
 
